# VeilTalk all-in-one: Next.js standalone + Bun signaling in one container
# 构建阶段：Next.js standalone 产物
FROM node:22-alpine AS webbuild
WORKDIR /app
COPY package.json ./
RUN npm install --legacy-peer-deps
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate && npx next build

# 运行阶段：Bun 同时跑信令（3003/3004）与 Next standalone（3000）
FROM oven/bun:1-alpine
WORKDIR /app
RUN apk add --no-cache nodejs
COPY --from=webbuild /app/.next/standalone ./web
COPY --from=webbuild /app/.next/static ./web/.next/static
COPY --from=webbuild /app/public ./web/public
COPY mini-services/signaling-service ./signaling
RUN cd signaling && bun install

ENV NODE_ENV=production
ENV SIGNALING_PORT=3003
ENV SIGNALING_HTTP_PORT=3004
ENV PORT=3000
# 容器内存受限（Koyeb free 512MB）：限制 V8 旧生代，防 cgroup OOM
ENV NODE_OPTIONS=--max-old-space-size=256

# 启动脚本：HOSTNAME=0.0.0.0（Next standalone 默认绑定 $HOSTNAME，容器里它是
# 容器 ID，显式归零防绑定异常）；bun --smol 压缩信令内存；node 为主进程（exec，
# 信号直达）。Next 经 beforeFiles rewrites 反代 127.0.0.1:3003/3004。
COPY <<'EOF' /app/start.sh
#!/bin/sh
export HOSTNAME=0.0.0.0
cd /app/signaling
bun --smol index.ts &
cd /app/web
exec node server.js
EOF
RUN chmod +x /app/start.sh

EXPOSE 3000
CMD ["/app/start.sh"]
